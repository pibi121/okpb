# Used by `railway up` instead of .gitignore when present.
# Same as .gitignore, except infra/release-meta.json is INCLUDED so
# notifyOpsDeployOnBoot can read the commit sha after source deploy.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local uploads
/public/uploads/*
!/public/uploads/.gitkeep

# durable local lab data
/data/**
!/data/gallery/.gitkeep
!/data/backups/.gitkeep
!/data/characters/.gitkeep

# prisma local db
/prisma/*.db
/prisma/*.db-journal

# metalnode / infra secrets (release-meta.json intentionally NOT ignored)
/infra/*.key
/infra/metalnode.local.json
/infra/metalnode.llm.json
metalnode_id_ed25519

# local-only
/HANDOFF/

# cursor / temp
.cursor/
tmp_*
/scripts/_tmp-*
.tmp_*
klein_fix_latest.png

# large local datasets
/datasets/
/samples/

# optional local presets — ship JSON registries
/presets/*
!/presets/*.json
