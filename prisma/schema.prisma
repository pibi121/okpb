// ─── PeachBitch Telegram ───────────────────────────────────────────────────

/// External identity (Telegram user id is stable across bot migrations).
model PlatformAccount {
  id             String   @id @default(cuid())
  userId         String
  platform       String   @default("telegram")
  platformUserId String
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  /// Active TG character for generation
  activeCharacterId String?
  /// Last BotInstance that handled a message (for outbox routing in dual-bot).
  lastBotInstanceId String?
  /// idle | awaiting_lang | awaiting_rules | awaiting_photos | awaiting_speech | awaiting_character_name | awaiting_character_rename
  chatState      String   @default("idle")
  pendingJson    String   @default("{}")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, platformUserId])
  @@index([userId])
}

/// Active / dual / retired bot instances (redirect + multi-token polling).
model BotInstance {
  id            String    @id @default(cuid())
  username      String
  /// Telegram getMe.id as string
  telegramBotId String    @default("")
  /// AES-GCM encrypted bot token (empty = use TELEGRAM_BOT_TOKEN env for primary)
  tokenEnc      String    @default("")
  /// Primary = /bot redirect + default outbox fallback
  isPrimary     Boolean   @default(false)
  /// active | retired | banned
  status        String    @default("active")
  activatedAt   DateTime  @default(now())
  retiredAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([isPrimary, status])
  @@index([username])
}

/// Traffic partner (arbitrage). code used in ?start=ref_CODE.
model AffiliateAccount {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  /// percent of GMV (e.g. 50)
  commissionPct   Int      @default(50)
  /// active | paused
  status          String   @default("active")
  contact         String?
  totalEarnedRub  Int      @default(0)
  /// Minimum affiliate payout (USDT)
  minPayoutUsdt   Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attributions AffiliateAttribution[]
}

/// Links user to affiliate (lifetime attribution on first touch).
model AffiliateAttribution {
  id          String   @id @default(cuid())
  userId      String
  affiliateId String
  createdAt   DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([affiliateId])
}

/// TG user partner program (50% commission in 🍑).
model PartnerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  code               String   @unique
  commissionPct      Int      @default(50)
  balancePeaches     Int      @default(0)
  totalEarnedPeaches Int      @default(0)
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  links         PartnerLink[]
  commissions   PartnerCommission[]
  withdrawals   PartnerWithdrawal[]
  attributions  PartnerAttribution[]
}

model PartnerLink {
  id                 String   @id @default(cuid())
  partnerId          String
  slug               String
  label              String   @default("")
  clicks             Int      @default(0)
  signups            Int      @default(0)
  /// Paid topups attributed to this link
  purchases          Int      @default(0)
  purchaseGrossPeaches Int    @default(0)
  commissionPeaches  Int      @default(0)
  createdAt          DateTime @default(now())

  partner      PartnerProfile       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  attributions PartnerAttribution[]

  @@unique([partnerId, slug])
  @@index([partnerId])
}

model PartnerAttribution {
  id        String   @id @default(cuid())
  userId    String   @unique
  partnerId String
  linkId    String?
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  link    PartnerLink?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([partnerId])
}

model PartnerCommission {
  id            String   @id @default(cuid())
  partnerId     String
  referredUserId String
  /// Attribution link at purchase time (admin / per-link stats)
  linkId        String?
  grossPeaches  Int
  amountPeaches Int
  kind          String   @default("topup")
  createdAt     DateTime @default(now())

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

model PartnerWithdrawal {
  id            String   @id @default(cuid())
  partnerId     String
  amountPeaches Int
  status        String   @default("pending")
  payoutDetails String   @default("")
  adminNote     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
}

/// Own marketing start-links (not partner 50%). Payload: m_CODE
model TrafficLink {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String
  note            String   @default("")
  clicks          Int      @default(0)
  signups         Int      @default(0)
  purchases       Int      @default(0)
  purchasePeaches Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]
}

/// Grouped technical errors for the ops cabinet.
model OpsError {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  kind           String
  title          String
  sampleMessage  String   @default("")
  sampleStack    String   @default("")
  count          Int      @default(1)
  lastUserId     String   @default("")
  lastMetaJson   String   @default("{}")
  /// Generation stage when last seen (queued|running|download|notify|…)
  stage          String   @default("")
  /// JSON array of {at,stage,detail} for the latest incident
  timelineJson   String   @default("[]")
  lastJobId      String   @default("")
  lastRefType    String   @default("")
  lastRefId      String   @default("")
  buildVersion   String   @default("")
  autoRetryCount Int      @default(0)
  status         String   @default("open")
  firstAt        DateTime @default(now())
  lastAt         DateTime @default(now())

  @@index([status, lastAt])
  @@index([kind, lastAt])
}

/// Singleton ops switches + JSON blobs (prices, etc).
model OpsSetting {
  id                     String   @id @default("main")
  maintenance            Boolean  @default(false)
  maintenanceMessageRu   String   @default("")
  maintenanceMessageEn   String   @default("")
  loadMode               Boolean  @default(false)
  loadMessageRu          String   @default("")
  loadMessageEn          String   @default("")
  lastBroadcastAt        DateTime?
  pricesJson             String   @default("{}")
  /// SLO baselines JSON (wait/run ms per function)
  sloJson                String   @default("{}")
  /// Orchestrator flags: pending burst requests, budget caps (no provider keys yet)
  gpuOrchestratorJson    String   @default("{}")
  /// Funnel video-note file_ids + one-shot capture mode ("" | "ru" | "en")
  tgFunnelNoteRuFileId   String   @default("")
  tgFunnelNoteEnFileId   String   @default("")
  tgFunnelNoteCapture    String   @default("")
  /// Block uploads/gens that look like minors (local OpenCV age DNN on Railway)
  ageGateEnabled         Boolean  @default(true)
  /// JSON: blockBuckets, faceThresh, failClosed
  ageGateJson            String   @default("{}")
  updatedAt              DateTime @updatedAt
}

/// Registered GPU / Comfy workers (Metalnode now; RunPod/Vast later).
model GpuWorker {
  id              String    @id @default(cuid())
  key             String    @unique
  label           String
  /// metalnode | runpod | vast | hostkey | manual
  provider        String    @default("manual")
  /// photo | video | lora | any
  pool            String    @default("any")
  comfyUrl        String    @default("")
  enabled         Boolean   @default(true)
  /// online | busy | offline | draining | dead | pending_provider
  status          String    @default("unknown")
  lastHeartbeatAt DateTime?
  lastError       String    @default("")
  currentJobId    String?
  costRubPerHour  Int       @default(55)
  metaJson        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  jobs            GpuJob[]

  @@index([enabled, status])
  @@index([pool, status])
}

/// Persistent GPU job ledger (survives Railway redeploy; drives /ops/load).
model GpuJob {
  id          String    @id @default(cuid())
  kind        String
  /// photo | video | lora | any
  pool        String    @default("any")
  /// queued | assigned | running | done | error | cancelled
  status      String    @default("queued")
  userId      String?
  refType     String    @default("")
  refId       String    @default("")
  workerId    String?
  stage       String    @default("queued")
  timelineJson String   @default("[]")
  error       String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  waitMs      Int?
  runMs       Int?
  attempt     Int       @default(0)
  metaJson    String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  worker GpuWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([status, pool, queuedAt])
  @@index([workerId, status])
  @@index([refType, refId])
  @@index([kind, finishedAt])
  @@index([userId, createdAt])
}

/// Editable bot funnel copy (overrides i18n).
model BotCopy {
