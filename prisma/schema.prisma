/// Krea Identity Edit photo template for TG / Mini App.
model PhotoTemplate {
  id              String   @id @default(cuid())
  title           String
  notes           String   @default("")
  /// basic | pose
  tier            String   @default("basic")
  pricePeaches    Int      @default(54)
  editPrompt      String   @default("")
  sceneImageUrl   String   @default("")
  previewImageUrl String   @default("")
  hasSpeech       Boolean  @default(false)
  titleEn         String   @default("")
  notesEn         String   @default("")
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  /// Published to Telegram bot + Mini App catalog
  tgPublished     Boolean  @default(false)
  /// Override title shown in TG (empty = use title)
  tgDisplayTitle  String   @default("")
  /// sex | display | dirt | public | humiliation | empty = uncategorized
  sceneCategory   String   @default("")
  /// Author character id (feed: don't show same identity twice in a row)
  previewIdentityKey String @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([tgPublished, sortOrder])
}

/// TG delivery queue — bot polls and sends to chat.
model TgOutbox {
  id               String    @id @default(cuid())
  platformUserId   String
  userId           String
  kind             String
  payloadJson      String    @default("{}")
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([platformUserId, sentAt])
  @@index([userId])
}

/// Product funnel: every meaningful click/screen for ops + AI export.
model FunnelEvent {
  id             String   @id @default(cuid())
  userId         String
  platformUserId String   @default("")
  at             DateTime @default(now())
  /// Days since signup (0 = first calendar day window from createdAt)
  dayIndex       Int      @default(0)
  /// bot | miniapp | system
  surface        String
  /// Machine key from funnel catalog
  eventKey       String
  /// Human title (RU) for AI / ops
  stepTitle      String
  /// Longer plain-language explanation of what happened
  stepDetail     String   @default("")
  /// traffic | partner | organic | unknown
  sourceKind     String   @default("unknown")
  sourceCode     String   @default("")
  metaJson       String   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
  @@index([eventKey, at])
  @@index([sourceKind, sourceCode, at])
  @@index([surface, at])
}

/// Ops promo codes: credit peaches (1 redeem per user, global max uses).
model PromoCode {
  id              String   @id @default(cuid())
  /// Stored uppercase, unique
  code            String   @unique
  amountPeaches   Int
  /// Total number of distinct users who may redeem
  maxRedemptions  Int
  redeemedCount   Int      @default(0)
  enabled         Boolean  @default(true)
  note            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions PromoRedemption[]

  @@index([enabled, code])
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

/// Mini App banners (horizontal carousel / vertical feed inserts).
model MiniAppBanner {
  id        String   @id @default(cuid())
  /// horizontal | vertical
  kind      String
  imageUrl  String
  /// In-app path or https URL
  href      String   @default("")
  label     String   @default("")
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, enabled, sortOrder])
}

/// Free-text / feedback messages from users in the bot (ops inbox).
model TgUserMessage {
  id             String    @id @default(cuid())
  userId         String
  platformUserId String
  /// inbound | outbound
  direction      String
  text           String
  /// unread inbound until staff opens / replies
  readAt         DateTime?
  replyToId      String?
  metaJson       String    @default("{}")
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([direction, readAt])
  @@index([platformUserId, createdAt])
}
